# =============================================================================
# HANORK BOT — Exemplo de configuração
# Copie este arquivo para .env e preencha os valores
# cp .env.example .env
#
# Variáveis comentadas como NÃO USADAS / TECH_DEBT — não copie para .env
# =============================================================================

# ── OBRIGATÓRIAS ─────────────────────────────────────────────────────────────

# Token do bot — obtenha em https://t.me/BotFather
TOKEN_TELEGRAM=seu_token_aqui

# Bot separado só para avisos no PV do admin (recomendado — @BotFather)
TOKEN_TELEGRAM_NOTIFY=seu_token_notify_aqui
ADMIN_NOTIFY_IDS=123456789
# 0 = avisos so no TOKEN_TELEGRAM_NOTIFY. 1 = fallback no bot principal se falhar
ADMIN_NOTIFY_FALLBACK_MAIN=0
# Novo membro no PV: 1 = bot principal · 0 = bot notify
# ADMIN_NOTIFY_NEW_MEMBER_VIA_MAIN=1
ADMIN_NOTIFY_CONSOLE_MIRROR=1
ADMIN_NOTIFY_ALL_EVENTS=true
ADMIN_NOTIFY_FLUSH_MS=2000
ADMIN_NOTIFY_MAX_LINES=12
ADMIN_NOTIFY_WA=1
# ADMIN_NOTIFY_USE_QUEUE=1   # envia avisos via fila Bull (notification:admin)
# KILL_LINUX_DUPLICATE_BOTS=1
# TELEGRAM_DROP_PENDING=1  # descarta fila Telegram no boot (perde mensagens offline)
# TELEGRAM_UPDATE_RECOVERY=1  # drain + dedup + fila retry (padrão: ativo)
# TELEGRAM_EVENT_DEBUG=1      # linha resumida no terminal; auditoria completa em telegram_event_audit (SQLite)
# TELEGRAM_RECOVERY_MAX_BATCHES=50
# TELEGRAM_RETRY_INTERVAL_MS=30000

# Access Token do Mercado Pago (PIX + Cartão) — obtenha em https://www.mercadopago.com.br/developers
TOKEN_MP=

# true = usa sandbox_init_point (credencial TEST-... ou teste explícito)
# MP_SANDBOX=true

# E-mail padrão do comprador (PIX + preferência)
# MP_PAYER_EMAIL=cliente@email.com

# CPF do pagador (11 dígitos, sem pontos) — exigido em várias contas MP Brasil para PIX
# MP_PAYER_CPF=12345678909
# MP_PAYER_FIRST_NAME=Cliente
# MP_PAYER_LAST_NAME=Hanork
# MP_API_TIMEOUT_MS=25000
# MP_STATEMENT_DESCRIPTOR=HANORK

# Token MP assinatura (NÃO REFERENCIADO em src/ — TECH_DEBT; hoje usa TOKEN_MP)
# TOKEN_MP_ASSINATURA=APP_USR-...

# IDs dos administradores do bot, separados por vírgula
# Para descobrir seu ID: envie /id para o bot após rodar
ID_DONO=123456789,987654321

# ── PONTE /entrar (conta Telegram sua — grupos públicos sem admin) ───────────
# my.telegram.org → API → api_id + api_hash
# Depois: npm run telegram:user-login (código SMS) e cole a SESSION abaixo
# TELEGRAM_USER_API_ID=12345678
# TELEGRAM_USER_API_HASH=abcdef1234567890abcdef1234567890
# TELEGRAM_USER_SESSION=1AgA...

# ── POOL PONTE MTProto (grupos do número — auto-join por link) ───────────────
# Máximo de grupos onde o número divulga simultaneamente
BRIDGE_PROMO_MAX=30
# Mínimo de membros para entrar e permanecer no pool
BRIDGE_PROMO_MIN_MEMBERS=150
# Manutenção: verifica membership/permissões (ms) — 900000 = 15 min
BRIDGE_POOL_MAINT_MS=900000
BRIDGE_POOL_MAX_LINKS_PER_MSG=5
BRIDGE_POOL_DEBOUNCE_MS=8000

# ── SERVIDOR / WEBHOOK ───────────────────────────────────────────────────────

# Porta do servidor HTTP (padrão: 3000)
PORT=3000
# IP manual se auto-detecção LAN falhar (celular no mesmo Wi‑Fi): ex. 192.168.1.42
# DASHBOARD_LAN_HOST=192.168.1.42

# URL pública do servidor para o webhook do Mercado Pago
# Deve ser HTTPS em produção. Configure no painel MP em:
# Suas integrações → Webhooks → URL de notificação
WEBHOOK_URL=https://seudominio.com/webhooks/mercadopago

# Secret para validação de assinatura HMAC do webhook (SEGURANÇA CRÍTICA)
# Obtido em: Mercado Pago → Desenvolvedores → Webhooks → Secret do webhook
# Isso protege contra spoofing de pagamentos (imprescindível em produção)
# O bot valida headers x-signature + x-request-id com este secret
# Se não configurado, a validação é ignorada (retrocompatibilidade, menos seguro)
MP_WEBHOOK_SECRET=seu_webhook_secret_aqui

# Dedup persistente de webhooks MP (processed_webhooks). Padrão: ativo. Rollback: MP_WEBHOOK_DB_DEDUP=0
# MP_WEBHOOK_DB_DEDUP=1

# Dedup Redis multi-instância (SET NX, 24h). Complementa memória + SQLite. Rollback: MP_WEBHOOK_REDIS_DEDUP=0
# MP_WEBHOOK_REDIS_DEDUP=1

# Receipt durável no SQLite antes do HTTP 200 + replay no boot (P5-1). Rollback: MP_WEBHOOK_DURABLE_ACK=0
# MP_WEBHOOK_SYNC_ACK=0  # 1 = processar pagamento antes de responder 200 (mais lento)

# Chave para criptografar token_mp no SQLite (produção: mín. 32 chars)
# Gere com: npm run gen:encryption-key
# Depois migre dados existentes: npm run migrate:encrypt-secrets
ENCRYPTION_KEY=

# Em produção o bot não sobe se faltar secret crítico (defina false só em dev local)
# SECURITY_STRICT=true

# Limite de requisições/min na vitrine web /loja/:slug
# VITRINE_RATE_LIMIT_PER_MIN=60

# Limite de requisições/min em GET /mp/go/:prefId (anti-enumeração MP)
# MP_GO_RATE_LIMIT_PER_MIN=40

# Só em teste local sem HMAC (NÃO use em produção)
# MP_ALLOW_UNSIGNED_WEBHOOK=true

# Desativa validação de IP do webhook (útil se o MP mudar os IPs ou para testes)
# Valores: true = desativa checagem | false (padrão) = valida IP
MP_SKIP_IP_CHECK=false

# ── LINKS DO NEGÓCIO ─────────────────────────────────────────────────────────

# URL do site principal (usado em links e mensagens)
SITE_HANORK=https://hanork.com

# URL pública opcional para links de download no e-mail (ex.: https://hanork.com/downloads)
# Se vazio, os arquivos vão como anexo no e-mail (pasta produtos/)
PRODUCT_DOWNLOAD_BASE_URL=

# Link legado (alias) — botões de comunidade usam SALES_REF_CHANNEL_LINK
# LINKGP=https://t.me/hanorkinfos

# Seu contato pessoal de suporte (botão «Suporte» — NÃO é link de grupo)
CONTATO_ESPECIALISTA=https://t.me/seuusuario

# Grupo onde tickets de suporte são roteados (/grupo suporte no grupo)
SUPPORT_GROUP_ID=-100xxxxxxxxxx
# (legado) Grupo de downloads — não é mais exigido; downloads ficam no PV
# DOWNLOADS_GROUP_ID=-100xxxxxxxxxx
# DOWNLOADS_GROUP_LINK=https://t.me/+seucodigodegrupo

# Canal @hanorkinfos — obrigatório para usar o bot + referências de venda
SALES_REF_CHANNEL_ID=-1004426605532
SALES_REF_CHANNEL_LINK=https://t.me/hanorkinfos
# REF_CHANNEL_REQUIRED=1
# DOWNLOADS_DAILY_LIMIT=100
# Para descobrir: adicione o bot ao grupo e envie /id lá dentro
GRUPO_ID=-100xxxxxxxxxx

# Links opcionais de parceiros/produtos externos
MIND7=https://mind-7.org
WORK=https://app.workconsultoria.com

# ── ZEROTWO API — /play, /tiktok, /gpt, broadcast IA ─────────────────────────

# Obtenha em: https://zero-two-apis.com.br
# Zero Two — /play, /tiktok, gpt, divulgação IA (obrigatório em produção)
# Zero Two — /play, /tiktok, /gpt, broadcast IA
API_KEY_ZEROTWO=
# ZEROTWO_API_KEY_REQUIRED=1   # padrão: exige API_KEY_ZEROTWO em NODE_ENV=production (qualquer valor válido)
# Domínio oficial jul/2026 — https://zero-two-apis.store
ZEROTWO_API=https://zero-two-apis.store
# Assistente: pool /api/ia/gpt · /api/ia/gpt4 · /api/ia/zerotwo · /gemini/texto/imagem (failover automático)
# Ordem fixa no .env — mesma lógica de rotas alternativas do /play e /tiktok
# ZEROTWO_AI_PROVIDERS=gpt,gpt4,gemini,zerotwo
ZEROTWO_AI_TIMEOUT_MS=28000
ZEROTWO_AI_ZEROTWO_TIMEOUT_MS=20000
ZEROTWO_AI_CONCURRENCY=1
# Intervalo mínimo entre chamadas GPT (evita 429 no boot/divulgação)
ZEROTWO_AI_MIN_GAP_MS=6000
# Pausa após HTTP 429 antes de tentar de novo
ZEROTWO_AI_429_COOLDOWN_MS=180000
# Boot guard: bloqueia IA automática por N ms após boot (template até liberar)
ZEROTWO_AI_BOOT_GUARD_MS=180000
# Cooldown por provedor após falha (ms)
ZEROTWO_AI_PROVIDER_COOLDOWN_MS=120000
# Cooldown por provedor após 429 (ms)
ZEROTWO_AI_PROVIDER_429_COOLDOWN_MS=240000
# 1 = cache de respostas IA no Redis (dual-write com memória; opt-in, sobrevive restart)
# ZEROTWO_AI_REDIS_CACHE=1
# ZEROTWO_AI_CACHE_TTL_MS=21600000
# Timeout Telegram menu /start (ms)
TELEGRAM_API_TIMEOUT_MS=25000
# Cache resumo financeiro no /start admin (ms)
# FINANCE_SUMMARY_CACHE_MS=60000

# ── IA legada (NÃO USADA — TECH_DEBT) ─────────────────────────
# Mantidas apenas para referência; o assistente usa ZeroTwo/GPT.

# USE_LOCAL_AI=false
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:0.5b
# GEMINI_KEY=

# ── EMAIL MARKETING (SMTP Gmail) ────────────────────────────────────────────

# Email para envio de notificações e campanhas
# Use App Password (não é a senha normal): myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=seuemail@gmail.com
SMTP_PASSWORD=sua_app_password_aqui

# Alias aceito pelo bot (use GEMINI_KEY ou GEMINI_API_KEY)
# GEMINI_API_KEY=sua_chave_gemini_aqui

# ── PAINEL WEB (/dashboard) ───────────────────────────────────────────────────

# Obrigatório em produção (sem isso o login web fica desativado)
DASHBOARD_USER=admin
# Em produção use APENAS hash (npm run hash:dashboard -- "sua_senha")
# DASHBOARD_PASS=sua_senha_forte_aqui
DASHBOARD_PASS_HASH=
# JWT do dashboard (persistente entre restarts)
# JWT do dashboard (use uma destas — JWT_SECRET já funciona)
DASHBOARD_JWT_SECRET=string_longa_aleatoria
# CSRF double-submit no dashboard (cookie dashboard_csrf + header X-CSRF-Token). Rollback: DASHBOARD_CSRF=0
# DASHBOARD_CSRF=1
# JWT_SECRET=mesma_chave_se_preferir
# V4 QW-6: JWT só via Authorization: Bearer ou cookie dashboard_token (sem ?token= na URL)
# Auditoria IDOR multi-tenant (SEC-C1 / evolução 4.1)
# DASHBOARD_TENANT_AUDIT=1   # padrão ligado — loga [DASHBOARD:IDOR-AUDIT]
# DASHBOARD_TENANT_ENFORCE=1  # obrigatório em produção com painel (P4-4 — bloqueia IDOR)
# DASHBOARD_IDOR_DEDUP_MS=60000

# ── GOOGLE SHEETS SYNC (NÃO IMPLEMENTADO — TECH_DEBT) ───────────────────────

# GOOGLE_SHEETS_API_KEY=
# GOOGLE_SHEETS_ID=

# ── REDIS / SISTEMA DE FILAS ────────────────────────────────────────────────

# URL de conexão com Redis (obrigatório para sistema de filas Bull)
# Padrão: redis://127.0.0.1:6379
# Para Redis com senha: redis://:senha@127.0.0.1:6379
# Para Redis Cloud: redis://usuario:senha@host.cloud.redislabs.com:port
REDIS_URL=redis://127.0.0.1:6379
# REDIS_FAIL_CLOSED_ENABLED=1   # pagamento/entrega recusam sem lock Redis; padrão ON em production
# REDIS_STATE_FAIL_CLOSED_ENABLED=1  # cart/checkout/wizard fail-closed (evolução 2.4)
# OPS_HEALTH_ALERTS_ENABLED=1
# OPS_HEALTH_ALERT_INTERVAL_MS=300000
# OPS_QUEUE_DEPTH_WARN=25
# OPS_SQLITE_BUSY_WARN=8
# PENDING_PURCHASE_INDEX_ENABLED=1
# GROUP_UPSERT_DEBOUNCE_MS=8000
# GROUP_MEMBER_UPSERT_DEBOUNCE_MS=15000

# Nome do bot para links de afiliados (sem @)
BOT_USERNAME=hanork_bot
# Marca na divulgação em grupos (/entrar parcial)
# BOT_DISPLAY_NAME=Hanork
# BOT_SHOP_TAGLINE=#Loja online 💰
# Link /start ao clicar "Comprar" — padrão: comprar (abre catálogo)
# BOT_SHOP_START_PAYLOAD=comprar
# Ou checkout direto de um produto:
# BOT_FEATURED_PRODUCT_ID=1
# Destaque também aparece no menu /start (texto + link buy_N)

# PIX auto-poll após QR (V4): verifica MP a cada 30s, até 10x. Desligar: PIX_AUTO_POLL=0
# PIX_AUTO_POLL_ATTEMPTS=10
# PIX_AUTO_POLL_INTERVAL_MS=30000
# Cartão/boleto auto-poll após checkout: verifica MP a cada 20s, até 24x (~8 min). Desligar: CARD_AUTO_POLL=0
# CARD_AUTO_POLL_ATTEMPTS=24
# CARD_AUTO_POLL_INTERVAL_MS=20000

# Carrinho abandonado: notifica após 30min (padrão V4). Intervalo do cron: 30min
# ABANDONED_CART_MINUTES=30
# ABANDONED_CART_INTERVAL_MS=1800000

# Intro IA no /start: desligada por padrão (texto fixo profissional). Ativar: HANORK_START_INTRO_AI=1
# Fotos de menu em infos/ (menu.jpg, menu2.jpg, …). Vazio = todas entram na rotação.
# MENU_PHOTO_SKIP=menu2.jpg

# Pasta de produtos digitais (padrão: ./produtos na raiz do projeto)
# PRODUCTS_PATH=/caminho/para/produtos
#
# Fotos — separadas por uso:
#   fotos/  → capas dos produtos (CAMINHO_FOTOS, padrão ./fotos)
#   infos/  → menus do bot: menu.jpg, menu2.jpg, … (CAMINHO_INFOS, padrão ./infos)
# CAMINHO_INFOS=/caminho/para/infos

# Relatório de saúde no Telegram (0 ou false = desligado)
# HEALTH_REPORT_ENABLED=0
# Intervalo em ms — padrão 2h (7200000)
# HEALTH_REPORT_INTERVAL_MS=7200000

# Hora do relatório diário (0-23) e fuso em horas (Brasil = -3)
# DAILY_REPORT_HOUR=20
# DAILY_REPORT_TZ_OFFSET=-3

# Redis alternativo (StateManager — use REDIS_URL se possível)
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Nível de log (DEBUG, INFO, WARN, ERROR)
# LOG_LEVEL=INFO

# Só divulgar onde o bot é admin? false = admin + membro comum (recomendado)
BROADCAST_REQUIRE_ADMIN=false

# ── DIVULGAÇÃO AUTOMÁTICA (PV + grupos + canais) ─────────────────────────────
# Ciclo: 1 produto rotativo · edita 1 msg/destino (anti-flood).
# Scheduler checa a cada 5 min; só dispara após passar AUTO_BROADCAST_INTERVAL_MS.
# Mínimo no código: 3600000 (1h). Recomendado: 7200000–14400000 (2–4h).
# Ativo ao subir (kv_store). Pausar: Admin → Broadcast.

# Textos de divulgação gerados pela API Zero Two (variando a cada rodada)
AUTO_BROADCAST_USE_AI=true
AUTO_BROADCAST_INTERVAL_MS=7200000
# Intervalo entre cada PV na fila (ms). Mínimo no código: 5000. Padrão: 60000 (~1 min).
AUTO_BROADCAST_USER_DELAY_MS=60000
AUTO_BROADCAST_GROUP_DELAY_MS=1500
AUTO_BROADCAST_CHANNEL_DELAY_MS=1800
# Pausa extra após cada job PV (worker serial). Padrão: 3000ms.
# BROADCAST_PV_MIN_GAP_MS=3000
# Jitter 0–0.5 sobre o delay base por destino (anti-padrão). Padrão: 0.25
# BROADCAST_PV_JITTER_RATIO=0.25
# Máx. PVs enfileirados por ciclo (0 = todos). Restante no retry parcial.
# AUTO_BROADCAST_MAX_USERS_PER_CYCLE=0
# Não dispara ciclo automático nos primeiros N ms após boot (evita tempestade DNS no WSL)
AUTO_BROADCAST_BOOT_GRACE_MS=600000
# Pausa/abort em falhas consecutivas de rede no broadcast PV
# BROADCAST_NET_FAIL_PAUSE_MS=15000
# BROADCAST_NET_FAIL_ABORT_AFTER=8

# ── ORQUESTRADOR DE CAMPANHAS (divulgação por slots) ─────────────────────────
# 0 = ciclo legado monolítico · 1 = slots HANORK/SMM por horário (recomendado prod)
# CAMPAIGN_ORCHESTRATOR=0
# CAMPAIGN_TIMEZONE=America/Sao_Paulo
# Grupos: 0/6 HANORK · 12/18 SMM · PV: 08 HANORK · 18 SMM
# CAMPAIGN_SLOT_WINDOW_MS=3600000
# CAMPAIGN_GROUP_COOLDOWN_MS=21600000
# CAMPAIGN_PV_MAX_PER_DAY=2
# Fotos nativas WSL (evita EIO em /mnt/c/…)
# CAMINHO_FOTOS=/home/vendetta/hanork/fotos

# URL opcional da foto do menu (deve ser https válida)
# MENU_PHOTO_URL=https://seudominio.com/menu.jpg

# ── LOCK INSTÂNCIA ÚNICA ──────────────────────────────────────────────────────
# Inicie com: node src/bot.js  (ou npm start)
# Segunda cópia encerra na hora — lock em .bot.lock (sem esperar ~45s)
# BOT_LOCK_WAIT_FOR_BOOT=1   # opcional: aguardar boot de outra instância (PM2 faz isso automaticamente)
# BOT_LOCK_BOOT_GRACE_MS=90000
# BOT_LOCK_MAX_WAIT_MS=180000

# ── BACKUP ───────────────────────────────────────────────────────────────────

# Máximo de backups mantidos (rotação)
# BACKUP_MAX_COUNT=30

# Intervalo do backup automático (horas)
# BACKUP_INTERVAL_HOURS=6

# Mínimo entre backups automáticos (ms) — padrão 5 min
# BACKUP_MIN_INTERVAL_MS=300000

# Só cria backup no boot se último sucesso > 4h
# BACKUP_STARTUP_MIN_GAP_MS=14400000

# Comprimir backups com gzip (0 = desligado)
# BACKUP_COMPRESS=1

# ── ASSINATURA PREMIUM (cliente) ─────────────────────────────────────────────

# Desconto automático no checkout para assinantes (0.10 = 10%)
# SUBSCRIPTION_CHECKOUT_DISCOUNT=0.10

# Cashback: base 5% / premium 10%
# CASHBACK_PERCENT=5
# SUBSCRIPTION_CASHBACK_PERCENT=10

# Cupons de boas-vindas na ativação
# SUBSCRIPTION_WELCOME_COUPON_PERCENT=20
# SUBSCRIPTION_WELCOME_COUPON_COUNT=5

# Lembrete de renovação manual (dias antes do vencimento)
# SUBSCRIPTION_REMINDER_DAYS=3

# ── AFILIADOS ────────────────────────────────────────────────────────────────

# Comissão em cada compra entregue do indicado (0.20 = 20%)
# AFFILIATE_COMMISSION_RATE=0.20

# Valor mínimo para solicitar saque via PIX (admin aprova manualmente)
# AFFILIATE_WITHDRAW_MIN=50

# ── POSTGRESQL (Preparação futura — não ativo em v3) ─────────────────────────

# DB_TYPE=sqlite
# DATABASE_URL=postgres://hanork:senha@localhost:5432/hanork

# ── CACHE / PERFORMANCE (legado — não referenciado em src/) ─────────────────

# CACHE_TTL=300
# SESSION_TTL=3600

# ── UX V4 (SP-6/7) ───────────────────────────────────────────────────────────

# Menu principal 6 botões (1=novo, 0=layout legado 10+ botões)
HANORK_MENU_V4=1

# ── OBSERVABILIDADE (SP-8) ───────────────────────────────────────────────────

# npm run obs:up  →  Grafana http://localhost:3001  Prometheus :9090
# HANORK_GRAFANA_PASS=hanork
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3001
# METRICS_STUCK_ORDER_MINUTES=10  # gauge hanork_stuck_paid_orders — alerta P5-3 após 5m > 0

# B2 Unified Router — telemetria (padrão ON; só observa, não altera roteamento)
# B2 Unified Router — telemetria ON por padrão; gateway completo só com =1
# HANORK_GATEWAY_TELEMETRY=1
# HANORK_GATEWAY_MISMATCH_LOG=1
# HANORK_GATEWAY=1
# HANORK_GATEWAY_LEGACY_WARN=1

# B4 Hanork AI Core — prompt registry + tools + provider health
# HANORK_AI_CORE=1
# HANORK_PROMPT_VERSION=v1
# ZEROTWO_AI_HEALTH_SORT=1

# ── AMBIENTE ─────────────────────────────────────────────────────────────────

# 'production' ativa validação de IP do webhook MP
# 'development' desativa a validação (útil para testes locais com ngrok)
NODE_ENV=production

# ── ZERO DIVU (WhatsApp via IPC — plugin isolado) ────────────────────────────
# false = Hanork ignora completamente o Zero (padrão — sem regressão)
# false = Hanork ignora completamente o Zero (sem botões /wa_* no admin)
# true  = painel 📱 WhatsApp, /help, /wa_* e sync com divulgação automática
ZERO_DIVU_ENABLED=false
# V4: worker usa ~/.zero-divu/zero-divu.db (não compartilha hanork.db). Rollback legado:
# WSL com projeto em /mnt/c/...: WAL do SQLite falha (SQLITE_CANTOPEN) — o bot usa DELETE automaticamente.
# Opcional: banco no filesystem Linux (mais estável):
# HANORK_DB_PATH=/home/SEU_USER/.hanork/hanork.db
# WSL + ~/.hanork → WAL (recomendado). DELETE só se o .db estiver em /mnt/c (drvfs).
# SQLITE_JOURNAL_MODE=WAL

# ZERO_DIVU_USE_HANORK_DB=1
# ZERO_DIVU_DB_PATH=~/.zero-divu/zero-divu.db
# Padrão (dentro do Hanork): ./zero-divu e ./shared/zero-ipc
# ZERO_DIVU_ROOT=./zero-divu
# ZERO_DIVU_IPC_DIR=./shared/zero-ipc
# ZERO_IPC_CMD_TIMEOUT_MS=30000
# ZERO_IPC_POLL_MS=500
# Token compartilhado Hanork ↔ zero-divu (mesmo valor nos dois .env)
# ZERO_IPC_TOKEN=gerar-string-secreta-longa
# Obrigatório em produção com ZERO_DIVU_ENABLED=true (validado no boot)
ZERO_IPC_AUTH_REQUIRED=1
# No zero-divu/.env: mesmo ZERO_IPC_AUTH_REQUIRED=1
# ZERO_DIVU_AUTO_PROFILE=true  # ajusta safe/balanced/aggressive pelo risco de spam
# ZERO_DIVU_PROFILE=balanced   # força perfil no boot (safe|balanced|aggressive) — ignora auto até /wa_auto on
# ZERO_DIVU_RESUME_JOIN_CAP=25 # quantos convites retomam na fila join após reinício (5–50, padrão 25)
# Sync catálogo WA: template (0) ou IA com fila GPT (1). Cache estável evita re-chamar API a cada sync.
HANORK_WA_CATALOG_USE_AI=0
# SP-5: catálogo IA via Bull ai:catalog (1=async, 0=sync bloqueante legado)
HANORK_WA_CATALOG_ASYNC_AI=1
# Intervalo entre jobs de produto na fila IA (ms) — 60s recomendado se 429 frequente
HANORK_WA_CATALOG_AI_PRODUCT_DELAY_MS=60000
# Promo produto → status WA via IA (1). Respeita fila + cooldown da API.
# HANORK_WA_PROMO_USE_AI=1
HANORK_WA_CATALOG_SYNC_DELAY_MS=120000
# HANORK_WA_CATALOG_AI_RETRY_MS=390000
# Boot: node src/bot.js (com ZERO_DIVU_ENABLED=true sobe WhatsApp junto)
# IPC inicial: npm run setup:zero-ipc

# ── Dual WA (Fase 0–1 — ver docs/audit/PLANO-DUAL-WA-PRODUCAO-2026-06-21.md) ─
# 0/false/off = só status nos grupos (sem texto/imagem espelhada no chat)
STATUS_MIRROR_TO_CHAT=0
# Manifesto sessões wa_a / wa_b (Fase 1 dual-WA)
# WA_SESSIONS_MANIFEST=./config/wa-sessions.json
# Ativar 2º worker + comandos /wa2_* (requer hanork-restart)
# WA_DUAL_ENABLED=1
# Promo automática: mesma copy nos 2 números (grupos exclusivos). Rollback só wa_a:
# WA_PROMO_PRIMARY_ONLY=1
# Após status nos grupos, envia pagamento c/ menção (@todos menos admins). 0=desliga
# HANORK_PROMO_WITH_PAYMENT=1

# ─── SMM FornecedorBrasil (Instagram, TikTok, etc.) ───────────────────────────
# 0 = desligado (zero impacto) · 1 = ativo no Telegram + schedulers
SMM_ENABLED=0

# API FornecedorBrasil
FORNECEDOR_BRASIL_API_KEY=
FORNECEDOR_BRASIL_API_URL=https://fornecedorbrasil.com/api/v2
FORNECEDOR_BRASIL_TIMEOUT_MS=30000

# Catálogo: importa all-services.json no 1º boot se banco vazio (1=sim, 0=não)
SMM_AUTO_IMPORT=1
SMM_CATALOG_JSON_PATH=./api/api/export/all-services.json

# Precificação: margem % e lucro mínimo em R$ por 1000 unidades
SMM_MARGIN_PERCENT=50
SMM_MIN_PROFIT=10

# Telegram: itens por página no catálogo
SMM_CATALOG_PAGE_SIZE=10
# Cache Redis: stats/plataformas (segundos)
SMM_CACHE_TTL_SEC=300

# Monitor pedidos abertos (ms) — padrão 10 min
SMM_ORDER_MONITOR_MS=600000
SMM_ORDER_MONITOR_BATCH=50
# Sync catálogo/preços com API (ms) — padrão 6 h
SMM_SYNC_INTERVAL_MS=21600000
# Monitor refill (ms) — padrão 15 min
SMM_REFILL_MONITOR_MS=900000
SMM_REFILL_MONITOR_BATCH=30

# Segurança: bloqueio pedido duplicado (min) + rate limit
SMM_DUPLICATE_WINDOW_MIN=15
SMM_RATE_LIMIT_MAX=20
SMM_RATE_LIMIT_WINDOW_SEC=60
# Catálogo público (1) ou beta só admin (0, padrão)
# Catálogo SMM aberto a todos (1). Use 0 para restringir a admins.
SMM_PUBLIC=1

# SMM na rotação AutoBroadcast (1 slot a cada N produtos quando SMM_PUBLIC=1)
AUTO_BROADCAST_SMM=1
AUTO_BROADCAST_SMM_EVERY_N=3

# Rotação de textos marketing/*.md nos slots Hanork/SMM (fallback: JSON themes)
BROADCAST_MARKETING_MD=1
# BROADCAST_MARKETING_DIR=marketing

# UX conversão — Semana 1
# Tour automático no /start (padrão off; use /tour). Reativar: WELCOME_TOUR_AUTO=1
WELCOME_TOUR_AUTO=0
# Produto em destaque no /start (padrão off — evita blocos extras)
# HANORK_START_FEATURED=1
# Lembrete PIX pendente (~15 min após gerar QR, antes do aviso de expiração)
# PIX_PENDING_REMINDER_AFTER_MIN=15
# PIX_PENDING_REMINDER_WINDOW_MIN=13
# PIX_PENDING_REMINDER_INTERVAL_MS=600000

# Semana 2 — calendário MD + canal ref
MARKETING_WEEKDAY_CALENDAR=1
SALES_REF_DAILY_PROMO=1
# SALES_REF_DAILY_PROMO_HOUR=10
# SALES_REF_DAILY_PROMO_CHECK_MS=900000

# Monitor saldo fornecedor (PV admin + botão recarga)
SMM_BALANCE_MONITOR=1
SMM_BALANCE_MONITOR_MS=1800000
SMM_BALANCE_WARN=50
SMM_BALANCE_CRITICAL=15
# Meta de saldo confortável p/ sugerir recarga (~2,5× aviso se omitido)
SMM_BALANCE_RECHARGE_TARGET=125
UP_FAMA_BALANCE_RECHARGE_TARGET=125
SMM_PROVIDER_RECHARGE_URL=https://fornecedorbrasil.com/

# ─── SMM Dual Provider (SSM + UP FAMA DIGITAL) ────────────────────────────────
# Segundo painel SMM — fallback automático quando o primário falha
UP_FAMA_API_KEY=
UP_FAMA_API_URL=https://upfamadigital.com/api/v2
UP_FAMA_TIMEOUT_MS=30000
UP_FAMA_RECHARGE_URL=https://upfamadigital.com/

# auto = SSM → UP fallback · ssm = só primário · up = só UP FAMA
SMM_PROVIDER_MODE=auto
# 1 = ativa fallback quando UP_FAMA_API_KEY existe (padrão 1)
SMM_DUAL_PROVIDER=1
# 1 = sync/listagem mescla catálogos com prefixo [SSM]/[UP]
SMM_DUAL_CATALOG=0
# Cache in-memory da lista de serviços por provedor (ms) — padrão 900000 (15 min)
SMM_PROVIDER_SERVICES_CACHE_MS=900000
# Mapeamento manual SSM↔UP (IDs equivalentes entre painéis)
# SMM_SERVICE_MAPPING_PATH=./src/modules/smm/config/serviceMapping.json

# Notificação novo membro — ver docs/admin/NEW-MEMBER-NOTIFY.md
# ADMIN_NOTIFY_BOOT_PING=1   # ping ao subir o bot de monitoramento

# ─── Virtuo SMS (E-SIM) — números virtuais + código SMS ─────────────────────
# Spec completa: docs/HANORK-STATUS.md §16
# Painel: https://sms.virtuoesim.com · Docs API: https://virtuoesim.com/docs
VIRTUO_ENABLED=0
VIRTUO_API_KEY=
VIRTUO_API_URL=https://api.virtuoesim.com
VIRTUO_API_TIMEOUT_MS=30000
VIRTUO_MARGIN_PERCENT=40
VIRTUO_MIN_PROFIT=2
# 0 = beta só admin · 1 = catálogo público (produção: 1 desde 03/07/2026)
VIRTUO_PUBLIC=1
VIRTUO_CATALOG_PAGE_SIZE=8
VIRTUO_SYNC_INTERVAL_MS=21600000
VIRTUO_POLL_INTERVAL_MS=8000
# Cancel automático ~28 min (API Virtuo: janela 2–30 min após compra)
VIRTUO_ACTIVATION_CANCEL_AT_MS=1680000
# alias legado — ignorado se VIRTUO_ACTIVATION_CANCEL_AT_MS estiver definido
VIRTUO_POLL_TIMEOUT_MS=1680000
VIRTUO_BALANCE_MONITOR=1
VIRTUO_BALANCE_WARN=30
VIRTUO_BALANCE_CRITICAL=10
VIRTUO_BALANCE_RECHARGE_TARGET=75
VIRTUO_PROVIDER_RECHARGE_URL=https://sms.virtuoesim.com/
# AUTO_BROADCAST_VIRTUO=1
AUTO_BROADCAST_VIRTUO_EVERY_N=4
# Hanork Div — assinatura WhatsApp divulgação (1 = ativo para usuários)
WA_DIVULGACAO_ENABLED=1
# Delay antes de requestPairingCode após WS connecting (Kelly-Bot / borutovk7, ms)
# WA_PAIRING_WS_DELAY_MS=5000
# WA_DIVULGACAO_ALWAYS_ON=1
# Hanork Div VIP — slot broadcast (requer WA_DIVULGACAO_ENABLED=1)
AUTO_BROADCAST_WADV=1
AUTO_BROADCAST_WADV_EVERY_N=5
